// Cloudflare Worker for abachedev.com: serves this folder as the website (static assets),
// and runs worker/index.js only for /api/* (the Google reviews endpoint).
// Deploy: `npx wrangler deploy`, or connect the GitHub repository in the Cloudflare dashboard.
// Files listed in .assetsignore are not uploaded as website files.
{
  "name": "abachedev",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Place ID of the AbacheDev Google Maps listing (not secret). The API key is a secret:
  // npx wrangler secret put GOOGLE_PLACES_KEY
  "vars": {
    "GOOGLE_PLACE_ID": ""
  }
}
